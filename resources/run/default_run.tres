[gd_resource type="Resource" script_class="RunConfig" format=3]
[ext_resource type="Script" path="res://scripts/run_config.gd" id="script"]
[ext_resource type="Resource" path="res://resources/run/map_settings.tres" id="map"]
[ext_resource type="PackedScene" path="res://scenes/run/starting_party.tscn" id="party"]
[ext_resource type="Script" path="res://scripts/run_encounter_definition.gd" id="encounter_type"]
[ext_resource type="Script" path="res://scripts/item_definition.gd" id="item_type"]
[ext_resource type="Resource" path="res://resources/run/boss.tres" id="boss"]
[ext_resource type="Resource" path="res://resources/run/terrain_showcase_normal.tres" id="terrain_showcase_normal"]
[ext_resource type="Resource" path="res://resources/run/terrain_showcase_elite.tres" id="terrain_showcase_elite"]
[ext_resource type="Resource" path="res://resources/run/goblin_skirmish_normal.tres" id="goblin_skirmish_normal"]
[ext_resource type="Resource" path="res://resources/run/goblin_skirmish_elite.tres" id="goblin_skirmish_elite"]
[ext_resource type="Resource" path="res://resources/items/wooden_sword.tres" id="wooden_sword"]
[ext_resource type="Resource" path="res://resources/items/iron_sword.tres" id="iron_sword"]
[ext_resource type="Resource" path="res://resources/items/ranger_bow.tres" id="ranger_bow"]
[ext_resource type="Resource" path="res://resources/items/frost_bow.tres" id="frost_bow"]
[ext_resource type="Resource" path="res://resources/items/ranger_armor.tres" id="ranger_armor"]
[ext_resource type="Resource" path="res://resources/items/sage_charm.tres" id="sage_charm"]
[resource]
script = ExtResource("script")
map_settings = ExtResource("map")
starting_party = ExtResource("party")
boss_encounter = ExtResource("boss")
normal_encounters = Array[ExtResource("encounter_type")]([ExtResource("terrain_showcase_normal"), ExtResource("goblin_skirmish_normal")])
elite_encounters = Array[ExtResource("encounter_type")]([ExtResource("terrain_showcase_elite"), ExtResource("goblin_skirmish_elite")])
equipment_pool = Array[ExtResource("item_type")]([ExtResource("wooden_sword"), ExtResource("iron_sword"), ExtResource("ranger_bow"), ExtResource("frost_bow"), ExtResource("ranger_armor"), ExtResource("sage_charm")])
