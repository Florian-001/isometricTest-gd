[gd_resource type="Resource" script_class="PassiveAbilityDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/passive_ability_definition.gd" id="passive"]
[ext_resource type="Script" path="res://scripts/passive_effect_definition.gd" id="effect_type"]
[ext_resource type="Script" path="res://scripts/reassemble_passive_effect.gd" id="effect"]
[ext_resource type="Texture2D" path="res://assets/characters/bone_pile.png" id="art"]

[sub_resource type="Resource" id="settings"]
script = ExtResource("effect")
pile_health = 1
restored_health_percentage = 100.0
pile_texture = ExtResource("art")

[resource]
script = ExtResource("passive")
passive_id = &"reassemble"
display_name = "Reassemble"
icon = ExtResource("art")
effects = Array[ExtResource("effect_type")]([SubResource("settings")])
