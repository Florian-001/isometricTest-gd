[gd_resource type="Resource" script_class="RunConfig" format=3]

[ext_resource type="Script" path="res://scripts/run_config.gd" id="script"]
[ext_resource type="Script" path="res://scripts/run_encounter_definition.gd" id="encounter_type"]
[ext_resource type="Script" path="res://scripts/run_combat_stage.gd" id="stage_type"]
[ext_resource type="Resource" path="res://resources/run/five_combats_map_settings.tres" id="map"]
[ext_resource type="Resource" path="res://resources/run/progression_normal.tres" id="normal"]
[ext_resource type="Resource" path="res://resources/run/five_combats_goblins.tres" id="goblins"]
[ext_resource type="Resource" path="res://resources/run/five_combats_skeletons.tres" id="skeletons"]
[ext_resource type="PackedScene" path="res://scenes/run/starting_party.tscn" id="party"]
[ext_resource type="PackedScene" path="res://scenes/friendlies/warrior.tscn" id="warrior"]
[ext_resource type="PackedScene" path="res://scenes/friendlies/archer.tscn" id="archer"]
[ext_resource type="PackedScene" path="res://scenes/friendlies/wizard.tscn" id="wizard"]
[ext_resource type="PackedScene" path="res://scenes/friendlies/cleric.tscn" id="cleric"]

[resource]
script = ExtResource("script")
display_name = "Five Combats"
map_settings = ExtResource("map")
starting_party = ExtResource("party")
starting_character_roster = Array[PackedScene]([ExtResource("warrior"), ExtResource("archer"), ExtResource("wizard"), ExtResource("cleric")])
normal_encounters = Array[ExtResource("encounter_type")]([ExtResource("normal")])
combat_stages = Array[ExtResource("stage_type")]([ExtResource("goblins"), ExtResource("skeletons")])
