[gd_resource type="Resource" script_class="StatusEffectDefinition" format=3]

[ext_resource type="Script" path="res://scripts/status_effect_definition.gd" id="status"]
[ext_resource type="Resource" path="res://resources/passives/counter.tres" id="passive"]

[resource]
script = ExtResource("status")
